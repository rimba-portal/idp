{
  "name": "rimba/idp",
  "description": "Basic Laravel Passport IdP for Rimba client applications.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.3|^8.4",
    "laravel/passport": "^13.0",
    "rimba/foundation": "*"
  },
  "autoload": {
    "psr-4": {
      "Rimba\\Idp\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Rimba\\Idp\\IdpServiceProvider"
      ]
    }
  },
  "minimum-stability": "alpha",
  "prefer-stable": true
}
